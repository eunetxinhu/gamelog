// =============================================================================
//  GameLog — schema.prisma (Prisma ORM 7 + Supabase Postgres)
// -----------------------------------------------------------------------------
//  • Prisma 7: a URL do banco NÃO fica mais aqui; ela vive em prisma.config.ts
//    e o client é instanciado com driver adapter (@prisma/adapter-pg).
//  • User.id === auth.users.id (UUID do Supabase Auth). O perfil público é
//    criado no primeiro login (ver src/lib/auth.ts → ensureProfile).
//  • A Steam é vinculada só por "Entrar com Steam" (OpenID 2.0, ver
//    src/lib/steam/openid.ts): o steamId nunca vem digitado pelo usuário.
//  • Constraints que o Prisma não expressa (CHECK de nota 1–5, posição 1–4 do
//    top 4, follow em si mesmo) estão em prisma/sql/constraints.sql — rode
//    após a primeira migration.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
//  Enums
// -----------------------------------------------------------------------------

enum LogStatus {
  PLAYING // "Jogando"
  COMPLETED // "Finalizado"
  PLATINUM // "Platinado" (100% das conquistas/troféus)
  DROPPED // "Dropado"
  BACKLOG // "Backlog"
}

/// Tipo de publicação no feed
enum ActivityType {
  STARTED_GAME // começou a jogar (detectado na Steam ou marcado como "Jogando")
  COMPLETED // finalizou
  PLATINUM // platinou (todas as conquistas na Steam ou marcado como "Platinado")
  DROPPED // dropou
  REVIEW // avaliou / escreveu review sem mudar de status
  RARE_ACHIEVEMENT // desbloqueou conquista que < 1% dos jogadores têm (Steam)
  SCREENSHOT // compartilhou um print, sem mudar de status nem avaliar
}

/// Reações numa publicação
enum ReactionType {
  LIKE // ❤ curtida
  GG // 🏆 "GG", só em platinas e finalizados
}

enum NotificationType {
  LIKE // curtiu sua publicação
  GG // mandou "GG" na sua platina/finalizado
  COMMENT // comentou na sua publicação
  FOLLOW // começou a seguir você
  PLATINUM // alguém que você segue platinou
  DEAL // jogo da sua wishlist entrou em promoção (sem actor)
  WEEKLY // seu resumo semanal está pronto (sem actor)
  MESSAGE // mensagem direta
  MENTION // te mencionou com @
  FOLLOW_REQUEST // pediu para seguir seu perfil privado
  INVITE_JOINED // alguém entrou pelo seu convite
  RELEASE // jogo da sua wishlist lançou hoje (sem actor)
  LIST_LIKE // curtiu sua lista
  LIST_COMMENT // comentou na sua lista
  AWARD // a moderação deu um título ou selo exclusivo
}

enum FollowStatus {
  ACCEPTED
  PENDING // perfil privado: aguardando aprovação
}

/// Quem pode mandar mensagem direta
enum DmPolicy {
  EVERYONE
  FOLLOWING // só quem eu sigo
  NOBODY
}

enum ClubRole {
  OWNER
  ADMIN
  MEMBER
}

enum ReportTarget {
  ACTIVITY
  COMMENT
  USER
  CLUB_POST
  MESSAGE
  LIST
  LIST_COMMENT
}

enum ReportStatus {
  OPEN
  RESOLVED // conteúdo removido / usuário suspenso
  DISMISSED // denúncia sem fundamento
}

enum LibrarySource {
  STEAM
  /// Jogo da Família Steam (emprestado): não vem no GetOwnedGames, só nos
  /// "jogados recentemente" ou quando o usuário registra o jogo no GameLog
  FAMILY
  MANUAL
}

// -----------------------------------------------------------------------------
//  User (perfil público + contas vinculadas)
// -----------------------------------------------------------------------------

model User {
  /// Mesmo UUID de auth.users (Supabase). Não usa default: vem do Auth.
  id          String  @id @db.Uuid
  username    String  @unique @db.VarChar(30)
  displayName String? @map("display_name") @db.VarChar(60)
  avatarUrl   String? @map("avatar_url")
  bio         String? @db.VarChar(280)
  /// Fundo do cabeçalho do perfil (URL de imagem; ex.: arte de um jogo)
  bannerUrl   String? @map("banner_url")

  // ---- Steam -----------------------------------------------------------------
  /// SteamID64 (17 dígitos, ex.: 76561198000000000), devolvido pelo login
  /// oficial da Steam. Único: uma conta Steam só pode estar em um perfil.
  steamId          String?   @unique @map("steam_id") @db.VarChar(17)
  steamPersonaName String?   @map("steam_persona_name")
  steamAvatarUrl   String?   @map("steam_avatar_url")
  steamLastSyncAt  DateTime? @map("steam_last_sync_at")

  // ---- Privacidade e moderação ----------------------------------------------
  /// Perfil privado: atividade e biblioteca só para seguidores aprovados
  isPrivate         Boolean   @default(false) @map("is_private")
  dmPolicy          DmPolicy  @default(FOLLOWING) @map("dm_policy")
  isAdmin           Boolean   @default(false) @map("is_admin")
  /// Notificações por categoria: { reactions: "off" | "app" | "push", … }.
  /// Null ou categoria ausente = "push" (ver src/lib/notification-prefs.ts)
  notificationPrefs Json?     @map("notification_prefs")
  /// Suspenso pela moderação: não publica, não comenta, não manda mensagem
  bannedAt          DateTime? @map("banned_at")
  /// Título especial ao lado do nome (ex.: "Fundador & CEO"). Só pelo banco: não tem tela para editar.
  title             String?   @db.VarChar(40)
  /// Símbolo e estilo do título (ver src/lib/awards.ts). Null = coroa / dourado
  titleIcon         String?   @map("title_icon") @db.VarChar(20)
  titleStyle        String?   @map("title_style") @db.VarChar(20)
  /// Concluiu ou pulou o "Primeiros passos" (null = ainda mostra o convite no feed)
  onboardedAt       DateTime? @map("onboarded_at")

  // ---- Convite ----------------------------------------------------------------
  invitedById String? @map("invited_by_id") @db.Uuid

  // ---- Sincronização escalonada da Steam ----------------------------------------
  /// Última visita ao site (gravada no máximo 1x por hora). Junto com as horas das
  /// últimas 2 semanas, define de quanto em quanto tempo o cron sincroniza a Steam.
  lastSeenAt      DateTime? @map("last_seen_at")
  /// Quando o cron deve sincronizar de novo (ver src/lib/steam/schedule.ts)
  steamNextSyncAt DateTime? @map("steam_next_sync_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ---- Relações --------------------------------------------------------------
  logs              GameLog[]
  library           LibraryEntry[]
  favorites         FavoriteGame[]
  activities        Activity[]
  likes             ActivityLike[]
  comments          Comment[]
  wishlist          WishlistItem[]
  syncJobs          SyncJob[]
  /// Notificações recebidas
  notifications     Notification[]     @relation("NotificationRecipient")
  /// Notificações que eu causei (curti, comentei, segui…)
  notificationsSent Notification[]     @relation("NotificationActor")
  followers         Follow[]           @relation("UserFollowers") // quem me segue
  following         Follow[]           @relation("UserFollowing") // quem eu sigo
  invitedBy         User?              @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees          User[]             @relation("Invites")
  pushSubscriptions PushSubscription[]
  blocks            Block[]            @relation("Blocker")
  blockedBy         Block[]            @relation("Blocked")
  reports           Report[]
  clubsOwned        Club[]
  clubMemberships   ClubMember[]
  clubPosts         ClubPost[]
  messagesSent      Message[]
  conversationsA    Conversation[]     @relation("ConversationA")
  conversationsB    Conversation[]     @relation("ConversationB")
  lists             GameList[]
  listLikes         GameListLike[]
  listComments      GameListComment[]
  /// Selos exclusivos recebidos (dados pela moderação)
  awards            AwardedBadge[]      @relation("AwardRecipient")
  awardsGiven       AwardedBadge[]      @relation("AwardGiver")

  @@index([steamNextSyncAt])
  // Busca tolerante a erros de digitação (pg_trgm, ver src/lib/search.ts)
  @@index([username(ops: raw("extensions.gin_trgm_ops"))], type: Gin, map: "users_username_trgm_idx")
  @@index([displayName(ops: raw("extensions.gin_trgm_ops"))], type: Gin, map: "users_display_name_trgm_idx")
  @@map("users")
}

// -----------------------------------------------------------------------------
//  Game (cache local do catálogo externo — RAWG/IGDB — e da Steam)
// -----------------------------------------------------------------------------

model Game {
  id              String    @id @default(cuid())
  /// Slug interno da rota /games/[slug]. Jogos vindos só da Steam começam como
  /// "steam-<appid>" até serem enriquecidos com dados da RAWG.
  slug            String    @unique
  title           String
  coverUrl        String?   @map("cover_url")
  summary         String?
  /// Só quando a loja informa o dia exato (ver src/lib/steam/dates.ts)
  releaseDate     DateTime? @map("release_date") @db.Date
  /// Ainda não lançou (loja da Steam "coming_soon" / RAWG "tba")
  comingSoon      Boolean   @default(false) @map("coming_soon")
  /// Data como a loja escreve quando não há dia exato ("1º tri. 2027", "Em breve")
  releaseDateText String?   @map("release_date_text")
  genres          String[]  @default([])
  platforms       String[]  @default([])

  // Ids externos (cada um opcional, mas único quando presente)
  rawgId     Int? @unique @map("rawg_id")
  igdbId     Int? @unique @map("igdb_id")
  steamAppId Int? @unique @map("steam_app_id")

  // ---- Mídia e ficha (loja da Steam) -----------------------------------------
  developers      String[]  @default([])
  publishers      String[]  @default([])
  /// Metascore (0–100) e link da página na Metacritic, vindos da loja da Steam
  metacriticScore Int?      @map("metacritic_score") @db.SmallInt
  metacriticUrl   String?   @map("metacritic_url")
  /// Arte larga para o fundo da página do jogo
  heroUrl         String?   @map("hero_url")
  /// [{ thumb, full }]
  screenshots     Json?
  /// [{ name, thumb, hls }]
  trailers        Json?
  /// Última vez que mídia/ficha vieram da loja (renova a cada 7 dias)
  mediaSyncedAt   DateTime? @map("media_synced_at")

  /// % de jogadores da Steam com a conquista mais rara = teto de quem tem a platina.
  /// Preenchido na primeira vez que alguém platina o jogo.
  platinumRarity          Float?    @map("platinum_rarity")
  platinumRarityCheckedAt DateTime? @map("platinum_rarity_checked_at")

  /// Média de horas jogadas na Steam segundo a RAWG (referência para "tempo para zerar"
  /// quando a comunidade ainda não tem dados; ver src/lib/time-to-beat.ts)
  rawgPlaytimeHours     Int?      @map("rawg_playtime_hours") @db.SmallInt
  rawgPlaytimeCheckedAt DateTime? @map("rawg_playtime_checked_at")

  /// Última vez que os metadados vieram da API externa (para revalidar cache).
  syncedAt  DateTime? @map("synced_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  logs       GameLog[]
  libraryOf  LibraryEntry[]
  favoriteOf FavoriteGame[]
  inLists    GameListItem[]
  activities Activity[]

  wishlistedBy  WishlistItem[]
  notifications Notification[]

  // Preço na Steam (BRL, centavos), atualizado pelo cron para jogos em alguma wishlist
  priceFinal      Int?      @map("price_final")
  priceOriginal   Int?      @map("price_original")
  discountPercent Int?      @map("discount_percent") @db.SmallInt
  priceCheckedAt  DateTime? @map("price_checked_at")

  @@index([title])
  @@index([releaseDate])
  @@index([title(ops: raw("extensions.gin_trgm_ops"))], type: Gin, map: "games_title_trgm_idx")
  @@map("games")
}

// -----------------------------------------------------------------------------
//  GameLog — o "registro" do jogo pelo usuário (status + nota + review)
//  Um log por (usuário, jogo); o feed lê esta tabela ordenada por updatedAt.
// -----------------------------------------------------------------------------

model GameLog {
  id     String    @id @default(cuid())
  userId String    @map("user_id") @db.Uuid
  gameId String    @map("game_id")
  status LogStatus

  /// 1 a 5 (CHECK em constraints.sql). Nulo = registrado sem nota.
  rating          Int?      @db.SmallInt
  review          String?
  containsSpoiler Boolean   @default(false) @map("contains_spoiler")
  startedAt       DateTime? @map("started_at") @db.Date
  finishedAt      DateTime? @map("finished_at") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, status]) // backlog / "jogando" do perfil
  @@index([gameId, createdAt(sort: Desc)]) // reviews na página do jogo
  @@index([updatedAt(sort: Desc)]) // feed global
  @@map("game_logs")
}

// -----------------------------------------------------------------------------
//  LibraryEntry — biblioteca importada (Steam) com horas jogadas
//  Separado de GameLog de propósito: possuir um jogo ≠ ter registrado/avaliado.
// -----------------------------------------------------------------------------

model LibraryEntry {
  userId                String        @map("user_id") @db.Uuid
  gameId                String        @map("game_id")
  source                LibrarySource @default(STEAM)
  playtimeMinutes       Int           @default(0) @map("playtime_minutes")
  playtime2WeeksMinutes Int           @default(0) @map("playtime_2weeks_minutes")
  lastPlayedAt          DateTime?     @map("last_played_at")

  // Conquistas (Steam). Checadas aos poucos a cada sincronização.
  achievementsUnlocked  Int?      @map("achievements_unlocked")
  achievementsTotal     Int?      @map("achievements_total")
  achievementsCheckedAt DateTime? @map("achievements_checked_at")
  /// Data da última conquista quando o jogo chega a 100%
  platinumAt            DateTime? @map("platinum_at")

  importedAt DateTime @default(now()) @map("imported_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([userId, playtimeMinutes(sort: Desc)]) // "mais jogados" no perfil
  @@index([gameId]) // "em alta" e tempo para zerar (por jogo)
  @@map("library_entries")
}

// -----------------------------------------------------------------------------
//  Activity — publicações do feed (automáticas da Steam ou de um GameLog)
// -----------------------------------------------------------------------------

model Activity {
  id              String        @id @default(cuid())
  userId          String        @map("user_id") @db.Uuid
  gameId          String        @map("game_id")
  type            ActivityType
  /// STEAM = detectado na sincronização; MANUAL = o usuário registrou
  source          LibrarySource @default(MANUAL)
  rating          Int?          @db.SmallInt
  review          String?
  containsSpoiler Boolean       @default(false) @map("contains_spoiler")
  /// Primeira foto (Supabase Storage). Mantida para compatibilidade: a lista completa é `images`
  imageUrl        String?       @map("image_url")
  /// Fotos da publicação (até 4), na ordem escolhida
  images          String[]      @default([])
  /// Dados do tipo (ex.: conquista rara: { apiName, name, icon, percent })
  meta            Json?
  createdAt       DateTime      @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  game          Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  likes         ActivityLike[]
  comments      Comment[]
  notifications Notification[]

  @@index([createdAt(sort: Desc)]) // feed global
  @@index([userId, createdAt(sort: Desc)]) // perfil + feed "seguindo"
  @@index([gameId, createdAt(sort: Desc)]) // atividade na página do jogo
  @@map("activities")
}

/// Reação numa publicação (curtida ou GG). Uma de cada tipo por pessoa.
model ActivityLike {
  activityId String       @map("activity_id")
  userId     String       @map("user_id") @db.Uuid
  type       ReactionType @default(LIKE)
  createdAt  DateTime     @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([activityId, userId, type])
  @@index([userId])
  @@map("activity_likes")
}

model Comment {
  id         String   @id @default(cuid())
  activityId String   @map("activity_id")
  userId     String   @map("user_id") @db.Uuid
  body       String   @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([activityId, createdAt])
  @@map("comments")
}

// -----------------------------------------------------------------------------
//  Notification — sino da barra (curtidas, comentários, seguidores, platinas)
// -----------------------------------------------------------------------------

model Notification {
  id         String           @id @default(cuid())
  /// Quem recebe
  userId     String           @map("user_id") @db.Uuid
  /// Quem causou (null nas notificações do sistema: promoção, resumo semanal)
  actorId    String?          @map("actor_id") @db.Uuid
  type       NotificationType
  activityId String?          @map("activity_id")
  /// Jogo relacionado (promoção)
  gameId     String?          @map("game_id")
  /// Lista relacionada (curtida ou comentário numa lista)
  listId     String?          @map("list_id")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  user     User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor    User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  game     Game?     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  list     GameList? @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
//  WishlistItem — "Quero jogar", com alerta de promoção
// -----------------------------------------------------------------------------

model WishlistItem {
  userId            String    @map("user_id") @db.Uuid
  gameId            String    @map("game_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  /// Preço (centavos) do último aviso de promoção; null = avisar na próxima promoção
  notifiedPrice     Int?      @map("notified_price")
  /// Já avisou que o jogo lançou
  releaseNotifiedAt DateTime? @map("release_notified_at")
  /// MANUAL = botão do site; STEAM = importado da wishlist da Steam (sai se sair de lá)
  source            WishlistSource @default(MANUAL)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([gameId])
  @@map("wishlist_items")
}

// -----------------------------------------------------------------------------
//  FavoriteGame — Top 4 do perfil
// -----------------------------------------------------------------------------

model FavoriteGame {
  userId   String @map("user_id") @db.Uuid
  gameId   String @map("game_id")
  /// 1 a 4 (CHECK em constraints.sql)
  position Int    @db.SmallInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, position])
  @@unique([userId, gameId])
  @@map("favorite_games")
}

// -----------------------------------------------------------------------------
//  Follow — grafo social (direcional, estilo Letterboxd)
// -----------------------------------------------------------------------------

model Follow {
  followerId  String       @map("follower_id") @db.Uuid
  followingId String       @map("following_id") @db.Uuid
  status      FollowStatus @default(ACCEPTED)
  createdAt   DateTime     @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// -----------------------------------------------------------------------------
//  Notificações push (Web Push)
// -----------------------------------------------------------------------------

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// -----------------------------------------------------------------------------
//  Mensagens diretas
// -----------------------------------------------------------------------------

/// Conversa entre dois usuários. userAId < userBId (ordem fixa = uma conversa por par).
model Conversation {
  id            String    @id @default(cuid())
  userAId       String    @map("user_a_id") @db.Uuid
  userBId       String    @map("user_b_id") @db.Uuid
  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  readAtA       DateTime? @map("read_at_a")
  readAtB       DateTime? @map("read_at_b")
  createdAt     DateTime  @default(now()) @map("created_at")

  userA    User      @relation("ConversationA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt(sort: Desc)])
  @@index([userBId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id") @db.Uuid
  body           String   @db.VarChar(2000)
  imageUrl       String?  @map("image_url")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// -----------------------------------------------------------------------------
//  Clubes
// -----------------------------------------------------------------------------

model Club {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(60)
  description String?  @db.VarChar(500)
  imageUrl    String?  @map("image_url")
  /// Regras do clube, escritas pelo dono ou pelos moderadores
  rules       String?  @db.VarChar(1000)
  ownerId     String   @map("owner_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  owner   User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members ClubMember[]
  posts   ClubPost[]

  @@map("clubs")
}

model ClubMember {
  clubId   String   @map("club_id")
  userId   String   @map("user_id") @db.Uuid
  role     ClubRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
  @@index([userId])
  @@map("club_members")
}

model ClubPost {
  id        String   @id @default(cuid())
  clubId    String   @map("club_id")
  userId    String   @map("user_id") @db.Uuid
  body      String   @db.VarChar(2000)
  imageUrl  String?  @map("image_url")
  /// Fixado no topo do mural pelos moderadores (no máximo 3 por clube)
  pinnedAt  DateTime? @map("pinned_at")
  createdAt DateTime @default(now()) @map("created_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt(sort: Desc)])
  @@map("club_posts")
}

// -----------------------------------------------------------------------------
//  Privacidade e moderação
// -----------------------------------------------------------------------------

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id         String       @id @default(cuid())
  reporterId String       @map("reporter_id") @db.Uuid
  targetType ReportTarget @map("target_type")
  targetId   String       @map("target_id")
  reason     String       @db.VarChar(40)
  details    String?      @db.VarChar(1000)
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at")
  resolvedAt DateTime?    @map("resolved_at")

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("reports")
}

// -----------------------------------------------------------------------------
//  Limite de requisições (janela fixa, ver src/lib/rate-limit.ts)
// -----------------------------------------------------------------------------

model RateLimit {
  /// "<ação>:<janela em s>:<usuário ou IP com hash>"
  key         String   @db.VarChar(160)
  windowStart DateTime @map("window_start")
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

// -----------------------------------------------------------------------------
//  Listas da comunidade ("Metroidvanias curtos", "Para jogar em dupla"…)
// -----------------------------------------------------------------------------

model GameList {
  id          String   @id @default(cuid())
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(80)
  description String?  @db.VarChar(1000)
  /// Lista numerada (ranking) ou só uma coleção
  ranked      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         GameListItem[]
  likes         GameListLike[]
  comments      GameListComment[]
  notifications Notification[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("game_lists")
}

model GameListItem {
  listId   String  @map("list_id")
  gameId   String  @map("game_id")
  /// Ordem na lista, a partir de 1
  position Int     @db.SmallInt
  /// Comentário curto do autor sobre o jogo na lista
  note     String? @db.VarChar(280)

  list GameList @relation(fields: [listId], references: [id], onDelete: Cascade)
  game Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([listId, gameId])
  @@index([listId, position])
  @@index([gameId])
  @@map("game_list_items")
}

model GameListLike {
  listId    String   @map("list_id")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  list GameList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([listId, userId])
  @@index([userId])
  @@index([createdAt])
  @@map("game_list_likes")
}

model GameListComment {
  id        String   @id @default(cuid())
  listId    String   @map("list_id")
  userId    String   @map("user_id") @db.Uuid
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")

  list GameList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listId, createdAt])
  @@map("game_list_comments")
}

// -----------------------------------------------------------------------------
//  Selos exclusivos: dados à mão pela moderação (nome, símbolo e estilo livres)
// -----------------------------------------------------------------------------

model AwardedBadge {
  id          String   @id @default(cuid())
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(40)
  description String?  @db.VarChar(140)
  /// Chave de src/lib/awards.ts (AWARD_SYMBOLS)
  icon        String   @db.VarChar(20)
  /// Chave de src/lib/awards.ts (AWARD_STYLES)
  style       String   @db.VarChar(20)
  awardedById String?  @map("awarded_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  user      User  @relation("AwardRecipient", fields: [userId], references: [id], onDelete: Cascade)
  awardedBy User? @relation("AwardGiver", fields: [awardedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("awarded_badges")
}

// -----------------------------------------------------------------------------
//  Erros em produção (agrupados): a moderação vê em /moderacao/erros e recebe push
// -----------------------------------------------------------------------------

model ErrorEvent {
  id          String    @id @default(cuid())
  /// Hash de tipo + mensagem + rota: o mesmo erro repetido vira uma linha só
  fingerprint String    @unique @db.VarChar(64)
  kind        String    @db.VarChar(20)
  message     String    @db.VarChar(500)
  stack       String?
  path        String?   @db.VarChar(300)
  method      String?   @db.VarChar(10)
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  /// Último push mandado para os administradores (no máximo 1 por hora por erro)
  notifiedAt  DateTime? @map("notified_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@index([resolvedAt, lastSeenAt(sort: Desc)])
  @@map("error_events")
}

// -----------------------------------------------------------------------------
//  Fila de sincronização da Steam: cada sincronização é um job dividido em tarefas
//  (biblioteca → conquistas em lotes paralelos, conquistas raras, capas, wishlist
//  → finalizar). Ver src/lib/jobs/.
// -----------------------------------------------------------------------------

enum WishlistSource {
  MANUAL
  STEAM
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum SyncTrigger {
  /// Botão "Sincronizar agora" ou acabou de vincular
  MANUAL
  /// Abriu o site com a última sincronização velha
  AUTO
  /// Cron (sincronização escalonada)
  CRON
}

enum SyncStep {
  LIBRARY
  ACHIEVEMENTS
  RARE
  COVERS
  WISHLIST
  FINALIZE
}

enum SyncTaskStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  SKIPPED
}

model SyncJob {
  id         String        @id @default(cuid())
  userId     String        @map("user_id") @db.Uuid
  status     SyncJobStatus @default(QUEUED)
  trigger    SyncTrigger
  /// Resumo para a tela (jogos novos, platinas publicadas, wishlist importada…)
  result     Json?
  /// { code, message, privacyReason? } quando falhou
  error      Json?
  createdAt  DateTime      @default(now()) @map("created_at")
  startedAt  DateTime?     @map("started_at")
  finishedAt DateTime?     @map("finished_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks SyncTask[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("sync_jobs")
}

model SyncTask {
  id         String         @id @default(cuid())
  jobId      String         @map("job_id")
  step       SyncStep
  status     SyncTaskStatus @default(QUEUED)
  /// Entrada da etapa (ex.: os appids do lote de conquistas)
  payload    Json?
  /// Saída da etapa, somada no FINALIZE
  result     Json?
  error      String?        @db.VarChar(500)
  attempts   Int            @default(0)
  /// Não pega antes disso (nova tentativa com espera crescente)
  runAfter   DateTime       @default(now()) @map("run_after")
  /// Quando um worker pegou; se ficar velho (worker caiu), volta para a fila
  lockedAt   DateTime?      @map("locked_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  finishedAt DateTime?      @map("finished_at")

  job SyncJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([jobId, status])
  @@map("sync_tasks")
}
