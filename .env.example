# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave secreta (Project Settings → API Keys → Secret keys). Só no servidor.
# Necessária para o "Entrar com Steam" sem conta (cria o usuário pela API de admin).
SUPABASE_SECRET_KEY=sb_secret_xxx

# Runtime (pooler / transaction mode, porta 6543)
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Migrations (conexão direta / session mode, porta 5432) — lida pelo prisma.config.ts
DIRECT_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# --- App ---------------------------------------------------------------------
# URL pública exata do site (sem barra no final). A Steam devolve o login para
# APP_URL/api/steam/callback, então precisa bater com o endereço real.
APP_URL=http://localhost:3000

# --- APIs externas ----------------------------------------------------------
STEAM_API_KEY=
RAWG_API_KEY=                  # https://rawg.io/apidocs

# --- Cron (Vercel) -------------------------------------------------------------
# Protege /api/cron/*. Gere com: openssl rand -base64 32. A Vercel manda sozinha
# "Authorization: Bearer <CRON_SECRET>" nas chamadas do cron (vercel.json).
CRON_SECRET=
