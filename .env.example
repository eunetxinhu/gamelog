# --- Banco (Neon, região AWS us-west-2 / Oregon) ----------------------------
# Neon → Connect. Runtime: conexão COM pooling (host com "-pooler")
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require
# Migrations: conexão DIRETA (mesmo host sem "-pooler") — lida pelo prisma.config.ts
DIRECT_URL=postgresql://USUARIO:SENHA@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require

# --- Fotos (Cloudflare R2) ---------------------------------------------------
# Cloudflare → R2 → bucket (ex.: poneglyph-media) com "Public access" ligado
# (r2.dev ou domínio próprio) e um token "Object Read & Write" só desse bucket.
# Sem estas variáveis o upload de fotos fica desligado.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=poneglyph-media
# URL pública do bucket, sem barra no final (ex.: https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=

# --- E-mails (Resend) ----------------------------------------------------------
# Confirmação de cadastro e "Esqueci a senha". Sem as duas, o cadastro já entra
# direto (sem confirmar o e-mail) e "Esqueci a senha" fica desligado.
RESEND_API_KEY=
# Remetente num domínio verificado no Resend
EMAIL_FROM="Poneglyph <nao-responda@seu-dominio>"

# --- App ---------------------------------------------------------------------
# URL pública exata do site (sem barra no final). A Steam devolve o login para
# APP_URL/api/steam/callback, então precisa bater com o endereço real.
APP_URL=http://localhost:3000

# --- APIs externas ----------------------------------------------------------
STEAM_API_KEY=
RAWG_API_KEY=                  # https://rawg.io/apidocs

# --- Notificações push (Web Push) -----------------------------------------------
# Gere com: npx web-push generate-vapid-keys. A pública vai para o navegador.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato enviado aos serviços de push (URL do site ou mailto:)
VAPID_SUBJECT=https://seu-dominio

# --- Cron (Vercel) -------------------------------------------------------------
# Protege /api/cron/*. Gere com: openssl rand -base64 32. A Vercel manda sozinha
# "Authorization: Bearer <CRON_SECRET>" nas chamadas do cron (vercel.json).
CRON_SECRET=
